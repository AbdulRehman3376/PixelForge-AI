# =========================
# PixelForge .gitignore
# =========================

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
venv/
.venv/
env/
ENV/

# PixelForge runtime / temporary files
Temp/
temp/
tmp/
logs/
cache/
Cache/

# Python / pip cache
pip-cache/
.pip-cache/
.cache/

# AI / ML downloaded models
models/
Models/
*.onnx
*.pth
*.pt
*.bin
*.safetensors
*.ckpt

# HuggingFace / Transformers / Torch cache
HuggingFace/
huggingface/
transformers/
Torch/

# FFmpeg
ffmpeg/

# Generated / processed files
output/
outputs/
generated/
processed/
exports/
results/

# Runtime data
data/
runtime/
sessions/

# Database / local runtime database
database/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Local configuration / secrets
config.json
.env
.env.*

# Custom user-generated presets
presets/custom_presets.json

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build / packaging
build/
dist/
*.spec

# Backup files
*.bak
*.backup
*.old
# Local storage diagnostic script
find_c_usage.py
